---
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/neu.css";
import GradiantText from "../../../components/shared/GradiantText.astro";
import { articulosPublicados, ARTICULOS_POR_PAGINA } from "../../../utils/insights";

// Paginacion de Insights. Con los articulos que hay hoy no llega a mostrarse
// mas que la pagina 1, pero queda lista para cuando el blog crezca.
export async function getStaticPaths() {
  const posts = await articulosPublicados();
  const total = Math.max(1, Math.ceil(posts.length / ARTICULOS_POR_PAGINA));
  return Array.from({ length: total }, (_, i) => ({ params: { page: String(i + 1) } }));
}

const pagina = Number(Astro.params.page ?? "1");
const posts = await articulosPublicados();
const totalPaginas = Math.max(1, Math.ceil(posts.length / ARTICULOS_POR_PAGINA));
const desde = (pagina - 1) * ARTICULOS_POR_PAGINA;
const enPagina = posts.slice(desde, desde + ARTICULOS_POR_PAGINA);
const fecha = (d: unknown) =>
  new Date(String(d)).toLocaleDateString("es-CL", { day: "numeric", month: "long", year: "numeric" });
---

<Layout
  navActivo="insights"
  title={`Insights · Página ${pagina} | Continental Blowers Andes`}
  description="Articulos tecnicos sobre sopladores y compresores centrifugos, sus procesos industriales y su mantenimiento."
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" />

  <main class="neu-root">
    <div class="neu-wrap">
      <header class="neu-header neu-centrado">
        <h1><GradiantText>Insights</GradiantText></h1>
        <p class="neu-lead">Página {pagina} de {totalPaginas}</p>
      </header>

      <div class="neu-grid neu-cols-3 neu-articulos">
        {enPagina.map(({ data, slug }) => (
          <a class="neu-articulo" href={`/insights/${slug}/`}>
            {data.heroImage && (
              <div class="neu-photo neu-articulo-foto">
                <img src={data.heroImage} alt={data.title} width="800" height="600" loading="lazy" />
              </div>
            )}
            <h2>{data.title}</h2>
            <p>{data.description}</p>
            <span class="neu-articulo-fecha">{fecha(data.pubDate)}</span>
          </a>
        ))}
      </div>

      {totalPaginas > 1 && (
        <nav class="neu-nav neu-paginacion" aria-label="Paginación">
          {Array.from({ length: totalPaginas }, (_, i) => i + 1).map((n) => (
            <a
              href={n === 1 ? "/insights" : `/insights/page/${n}/`}
              class={n === pagina ? "is-active" : ""}
              aria-current={n === pagina ? "page" : undefined}
            >
              {n}
            </a>
          ))}
        </nav>
      )}
    </div>
  </main>
</Layout>

<style is:global>
  .neu-centrado { text-align: center; }
  .neu-centrado .neu-lead { margin-left: auto; margin-right: auto; }

  .neu-articulo { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .neu-articulo-foto { margin-bottom: 1.25rem; }
  .neu-articulo-foto img { transition: box-shadow 0.25s ease; }
  .neu-articulo:hover .neu-articulo-foto img { box-shadow: var(--neu-flat); }
  .neu-articulo h2 { font-size: 1.125rem; margin-bottom: 0.5rem; color: var(--neu-accent); }
  .neu-articulo p { font-size: 0.875rem; }
  .neu-articulo-fecha { margin-top: auto; padding-top: 1rem; font-size: 0.8125rem; opacity: 0.7; }

  .neu-paginacion { justify-content: center; margin-top: 3rem; }
</style>
