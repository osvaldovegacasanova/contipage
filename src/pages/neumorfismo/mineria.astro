---
import Layout from "../../layouts/Layout.astro";
import IndustryHero from "../../components/industrias/IndustryHero.astro";
import "../../styles/neu.css";
import { mineria } from "../../data/industrias/mineria";

// Copia experimental del hub de Minería en estilo neumórfico.
//
// El contenido NO se duplica: se lee del mismo src/data/industrias/mineria.ts
// que alimenta /sopladores-para-mineria, así que cualquier cambio de texto o de
// foto en test se refleja aquí solo y las dos versiones no se bifurcan.
//
// El hero es el ORIGINAL, sin tocar: se reutiliza el componente IndustryHero tal
// cual. Por eso queda fuera de .neu-root, que tiene padding propio y anularía su
// sangrado a pantalla completa. Lo neumórfico empieza debajo.
//
// El hub real queda intacto: esta ruta es aparte y no se enlaza desde el menú.
const industria = mineria;

// El párrafo que abre la sección son dos frases con jerarquía distinta: la
// primera afirma, la segunda respalda. Se parten en el primer punto para
// tratarlas en dos niveles, sin duplicar el texto del archivo de datos.
const introCompleto = industria.processesHeading.intro;
const corte = introCompleto.indexOf(". ");
const introAfirmacion = corte === -1 ? introCompleto : introCompleto.slice(0, corte + 1);
const introRespaldo = corte === -1 ? "" : introCompleto.slice(corte + 2);
---

<Layout
  title={`Experimento neumórfico · ${industria.seoTitle}`}
  description="Versión experimental del hub de Minería en estilo neumórfico. Página interna, no forma parte del sitio público."
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
  />

  <main>
    {/* Hero original, idéntico al del hub real */}
    <IndustryHero hero={industria.hero} breadcrumbLabel={industria.navLabel} />

    <div class="neu-root neu-below-hero">
      <div class="neu-wrap">
        <!-- Procesos -->
        <section class="neu-section">
          <div class="neu-processes-intro">
            <p class="neu-intro-afirmacion">{introAfirmacion}</p>
            {introRespaldo && <p class="neu-intro-respaldo">{introRespaldo}</p>}
          </div>

          <div class="neu-processes">
            {industria.processes.map((proceso, i) => (
              <article class={`neu-raised neu-card neu-process ${i % 2 === 1 ? "is-reversed" : ""}`}>
                <div class="neu-photo neu-process-photo">
                  <img src={proceso.image} alt={proceso.alt} width="800" height="600" loading="lazy" />
                </div>

                <div class="neu-process-text">
                  <span class="neu-step">{String(i + 1).padStart(2, "0")}</span>
                  <h2>{proceso.name}</h2>
                  <p>{proceso.description}</p>
                  {proceso.highlights && proceso.highlights.length > 0 && (
                    <ul class="neu-list">
                      {proceso.highlights.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- Cierre -->
        <section class="neu-section neu-section-last">
          <div class="neu-raised neu-card neu-closing">
            <span class="neu-icon neu-icon-lg">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </span>
            <h2>{industria.cta.title}</h2>
            <p>{industria.cta.description}</p>
            <a href={industria.cta.buttonHref} class="neu-btn">{industria.cta.buttonText}</a>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  /* Sólo lo propio de esta página. El sistema vive en src/styles/neu.css */

  /*
    Con el hero original arriba ya no hace falta el hueco que .neu-root reserva
    para la barra fija, ni forzar una altura mínima de pantalla completa.
  */
  .neu-below-hero { padding-top: 4rem; min-height: 0; }


  /* ---- Procesos ---- */
  /*
    Apertura de sección en dos niveles: la afirmación en escala de titular y la
    explicación en cuerpo. Reemplaza al encabezado en píldora que se quitó, sin
    agregar ninguna superficie nueva. Medidas más angostas que el cuerpo general
    para que la primera frase se lea de un golpe.
  */
  .neu-processes-intro { margin-bottom: 3rem; }
  .neu-intro-afirmacion {
    font-size: 1.5rem; font-weight: 500; line-height: 1.3;
    max-width: 34rem; margin-bottom: 1rem;
  }
  .neu-intro-respaldo {
    font-size: 1rem; font-weight: 300; line-height: 1.7; max-width: 42rem;
  }
  .neu-processes { display: flex; flex-direction: column; gap: 2.5rem; }

  .neu-process {
    display: grid; gap: 2rem; align-items: center; padding: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  /* La foto usa .neu-photo del sistema: apoyada directamente sobre la tarjeta. */
  .neu-process.is-reversed .neu-process-photo { order: 2; }

  .neu-step {
    display: inline-block; font-size: 1.75rem; font-weight: 600;
    color: var(--neu-dark); line-height: 1; margin-bottom: 0.75rem;
  }
  .neu-process-text h2 { font-size: 1.375rem; margin-bottom: 0.75rem; }
  .neu-process-text p { font-size: 0.9375rem; }
  .neu-process-text .neu-list { margin-bottom: 0; }

  /* En una columna el orden invertido estorba: la foto vuelve arriba siempre. */
  @media (max-width: 47.99rem) {
    .neu-process.is-reversed .neu-process-photo { order: 0; }
  }

  /* ---- Cierre ---- */
  .neu-closing { display: flex; flex-direction: column; align-items: flex-start; padding: 2.5rem; }
  .neu-closing h2 { font-size: 1.5rem; }
  .neu-closing p { max-width: 44rem; margin-bottom: 1.75rem; }
  .neu-section-last { margin-bottom: 0; }
</style>
