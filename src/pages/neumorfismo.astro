---
import Layout from "../layouts/Layout.astro";
import "../styles/neu.css";
import GradiantText from "../components/shared/GradiantText.astro";
import NeuNavbar from "../components/neumorfismo/NeuNavbar.astro";

// Referencia del sistema de diseño neumórfico. Esta página es la fuente de
// verdad del estilo: lo que se vea acá es lo que rige para las páginas que lo
// adopten. Los tokens y componentes viven en src/styles/neu.css.
//
// Página aislada: no se enlaza desde el menú y no toca ningún componente del
// sitio real.
//
// Decisiones tomadas respecto de la especificación original:
//  - Acento: azul de marca #0046ba en vez del púrpura #6c63ff del spec.
//  - Contexto claro forzado: el spec sólo funciona sobre fondos claros, así que
//    esta página define sus propios colores y no usa variantes dark:.

const paleta = [
  { nombre: "Fondo", valor: "#e0e5ec", uso: "Página, tarjetas e inputs. Todo comparte el mismo fondo." },
  { nombre: "Texto", valor: "#4a5568", uso: "Cuerpo y encabezados.", contraste: "5,94:1", estado: "ok" },
  { nombre: "Apagado", valor: "#8898aa", uso: "Texto secundario.", contraste: "2,33:1", estado: "falla" },
  { nombre: "Acento", valor: "#0046ba", uso: "Marca Continental.", contraste: "6,42:1", estado: "ok" },
  { nombre: "Acento del spec", valor: "#6c63ff", uso: "Púrpura original, descartado.", contraste: "3,41:1", estado: "falla" },
  { nombre: "Sombra clara", valor: "#ffffff", uso: "Luz desde arriba a la izquierda." },
  { nombre: "Sombra oscura", valor: "#a3b1c6", uso: "Sombra proyectada.", contraste: "1,72:1", estado: "falla" },
];

const pesos = [
  { peso: 300, nombre: "Light", uso: "Cuerpo, entradas y listas. El peso por defecto de la página." },
  { peso: 400, nombre: "Regular", uso: "Reservado. Casi no se usa: entre 300 y 500 no aporta jerarquía." },
  { peso: 500, nombre: "Medium", uso: "Titulares, antetítulos, enlaces y etiquetas de campo." },
  { peso: 600, nombre: "SemiBold", uso: "Sólo numerales de proceso y énfasis puntual dentro de un párrafo." },
];

const escala = [
  { clase: "neu-t-h1", etiqueta: "h1", muestra: "Sopladores para Minería", tamano: "2 – 3 rem", peso: "500", alto: "1,15", uso: "Título de página. Uno solo por página." },
  { clase: "neu-t-h2", etiqueta: "h2", muestra: "Procesos donde son clave", tamano: "1,5 rem", peso: "500", alto: "normal", uso: "Título de sección y de módulo de proceso." },
  { clase: "neu-t-h3", etiqueta: "h3", muestra: "Sopladores para combustión", tamano: "1,0625 rem", peso: "500", alto: "normal", uso: "Título de tarjeta." },
  { clase: "neu-eyebrow", etiqueta: ".neu-eyebrow", muestra: "Industrias", tamano: "0,75 rem", peso: "500", alto: "normal", uso: "Antetítulo. Mayúsculas, +0,08em, color de acento." },
  { clase: "neu-lead", etiqueta: ".neu-lead", muestra: "Aire y gas a presión para los procesos más exigentes de la gran minería.", tamano: "1,0625 rem", peso: "300", alto: "1,7", uso: "Entrada bajo el título. Máximo 46 rem de ancho." },
  { clase: "neu-t-body", etiqueta: "p", muestra: "Los sopladores centrífugos multietapa entregan caudal variable y presión constante en operación continua.", tamano: "1 rem", peso: "300", alto: "1,7", uso: "Cuerpo de texto general." },
  { clase: "neu-sub", etiqueta: ".neu-sub", muestra: "Cada proceso exige caudal y presión específicos.", tamano: "1 rem", peso: "300", alto: "1,7", uso: "Bajada explicativa de una sección." },
  { clase: "neu-link", etiqueta: ".neu-link", muestra: "Ver más detalles →", tamano: "0,875 rem", peso: "500", alto: "normal", uso: "Enlace de texto. Siempre en color de acento." },
  { clase: "neu-note", etiqueta: ".neu-note", muestra: "Página interna, no forma parte del sitio público.", tamano: "0,875 rem", peso: "300", alto: "1,7", uso: "Nota al pie de un bloque, en color de acento." },
];

const superficies = [
  { clase: "neu-raised", titulo: "Elevado", css: "6px 6px 12px #a3b1c6,\n-6px -6px 12px #ffffff" },
  { clase: "neu-pressed", titulo: "Hundido", css: "inset 4px 4px 8px #a3b1c6,\ninset -4px -4px 8px #ffffff" },
  { clase: "neu-flat", titulo: "Plano", css: "3px 3px 6px #a3b1c6,\n-3px -3px 6px #ffffff" },
];
---

<Layout
  sinNavbar
  title="Sistema de diseño · Neumorfismo | Continental Andes"
  description="Referencia del sistema de diseño neumórfico: tokens, superficies y componentes. Página interna, no forma parte del sitio público."
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
  />

  <main class="neu-root">
    <NeuNavbar activo="sistema" />
    <div class="neu-wrap">
      <!-- Encabezado -->
      <header class="neu-header">
        <span class="neu-eyebrow">Referencia interna</span>
        <h1>Sistema <GradiantText>neumórfico</GradiantText></h1>
        <p class="neu-lead">
          Superficies blandas que parecen extruidas o hundidas en un fondo único. No hay bordes:
          toda la profundidad viene de un par de sombras, una clara arriba a la izquierda y una
          oscura abajo a la derecha.
        </p>
        <p class="neu-note">
          Esta página es la referencia del sistema: lo que aparece acá es lo que rige para las
          páginas que adopten el estilo. No está enlazada desde el sitio y no modifica ningún
          componente existente.
        </p>
      </header>

      <!-- Tipografía -->
      <section class="neu-section">
        <h2>Tipografía</h2>
        <p class="neu-sub">
          Poppins, con Raleway de reserva. La restricción de pesos es deliberada: en este estilo
          la profundidad la dan las sombras, no la letra. Espaciado normal salvo en el antetítulo.
        </p>

        <h3 class="neu-subhead">Pesos</h3>
        <div class="neu-grid neu-grid-2 neu-weights">
          {pesos.map((p) => (
            <div class="neu-raised neu-card">
              <p class="neu-weight-sample" style={`font-weight:${p.peso}`}>Transformamos el aire</p>
              <p class="neu-weight-meta"><strong>{p.peso}</strong> · {p.nombre}</p>
              <p>{p.uso}</p>
            </div>
          ))}
        </div>

        <h3 class="neu-subhead">Escala</h3>
        <div class="neu-raised neu-card neu-scale">
          {escala.map((e) => (
            <div class="neu-scale-row">
              <div class="neu-scale-sample">
                <p class={e.clase}>{e.muestra}</p>
              </div>
              <div class="neu-scale-meta">
                <code>{e.etiqueta}</code>
                <span>{e.tamano} · peso {e.peso} · interlineado {e.alto}</span>
                <span class="neu-scale-use">{e.uso}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="neu-pressed neu-card neu-rules">
          <p><strong>Ancho de lectura.</strong> Los bloques de texto se limitan a 46 rem, unos 75 caracteres. Más ancho y el ojo pierde el renglón al volver.</p>
          <p><strong>Un solo acento por bloque.</strong> El color de marca marca enlaces, antetítulos y notas. Si todo destaca, nada destaca.</p>
          <p><strong>Sin mayúsculas fuera del antetítulo.</strong> Es el único estilo que las usa, y con +0,08em de espaciado para que respiren.</p>
        </div>
      </section>

      <!-- Paleta -->
      <section class="neu-section">
        <h2>Paleta</h2>
        <p class="neu-sub">
          La regla central del estilo: página, tarjetas e inputs comparten exactamente el mismo
          fondo. La jerarquía no la da el color sino la sombra.
        </p>
        <div class="neu-grid neu-grid-3">
          {paleta.map((c) => (
            <div class="neu-raised neu-card">
              <div class="neu-swatch" style={`background:${c.valor}`}></div>
              <h3>{c.nombre}</h3>
              <code>{c.valor}</code>
              <p>{c.uso}</p>
              {c.contraste && (
                <p class={`neu-ratio ${c.estado === "falla" ? "is-fail" : "is-ok"}`}>
                  Contraste {c.contraste} · {c.estado === "falla" ? "no cumple AA" : "cumple AA"}
                </p>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Superficies -->
      <section class="neu-section">
        <h2>Superficies</h2>
        <p class="neu-sub">Los tres estados sobre los que se construye todo lo demás.</p>
        <div class="neu-grid neu-grid-3">
          {superficies.map((s) => (
            <div class={`${s.clase} neu-card`}>
              <h3>{s.titulo}</h3>
              <code class="neu-code-block">{s.css}</code>
            </div>
          ))}
        </div>
      </section>

      <!-- Botones -->
      <section class="neu-section">
        <h2>Botones</h2>
        <p class="neu-sub">
          Al pasar el cursor la sombra crece; al presionar se invierte y el botón se hunde.
        </p>
        <div class="neu-row">
          <button class="neu-btn" type="button">Solicitar asesoría</button>
          <button class="neu-btn neu-btn-accent" type="button">Contactar</button>
          <button class="neu-btn" type="button" disabled>Deshabilitado</button>
        </div>
      </section>

      <!-- Formulario -->
      <section class="neu-section">
        <h2>Campos de formulario</h2>
        <p class="neu-sub">
          Los inputs van hundidos, como si el fondo se hubiera presionado hacia adentro. Al
          enfocarse aparece un anillo del color de acento.
        </p>
        <div class="neu-form">
          <label>
            <span>Nombre</span>
            <input class="neu-input" type="text" placeholder="Su nombre" />
          </label>
          <label>
            <span>Correo</span>
            <input class="neu-input" type="email" placeholder="nombre@empresa.cl" />
          </label>
          <label class="neu-form-full">
            <span>Consulta técnica</span>
            <textarea class="neu-input" rows="4" placeholder="Cuéntenos sobre su proceso"></textarea>
          </label>
        </div>
      </section>

      <!-- Controles -->
      <section class="neu-section">
        <h2>Controles</h2>
        <div class="neu-grid neu-grid-2">
          <div class="neu-raised neu-card">
            <h3>Interruptores</h3>
            <div class="neu-row neu-row-tight">
              <span class="neu-toggle" data-toggle role="switch" aria-checked="false" tabindex="0">
                <span class="neu-toggle-thumb"></span>
              </span>
              <span class="neu-toggle is-on" data-toggle role="switch" aria-checked="true" tabindex="0">
                <span class="neu-toggle-thumb"></span>
              </span>
            </div>
            <p>Pista hundida, perilla elevada. Al activarse se desplaza y toma el acento.</p>
          </div>

          <div class="neu-raised neu-card">
            <h3>Barras de progreso</h3>
            <div class="neu-progress"><span style="width:72%"></span></div>
            <div class="neu-progress"><span style="width:38%"></span></div>
            <p>Pista hundida con relleno degradado, sin sombra propia.</p>
          </div>
        </div>
      </section>

      <!-- Iconos y navegación -->
      <section class="neu-section">
        <h2>Iconos y navegación</h2>
        <div class="neu-grid neu-grid-2">
          <div class="neu-raised neu-card">
            <h3>Círculos de icono</h3>
            <div class="neu-row neu-row-tight">
              {["M13 10V3L4 14h7v7l9-11h-7z", "M5 13l4 4L19 7", "M12 4v16m8-8H4"].map((d) => (
                <span class="neu-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                  </svg>
                </span>
              ))}
            </div>
            <p>56 px de diámetro, elevados, con el icono en color de acento.</p>
          </div>

          <div class="neu-raised neu-card">
            <h3>Navegación</h3>
            <nav class="neu-nav">
              <a href="#" class="is-active">Industrias</a>
              <a href="#">Servicios</a>
              <a href="#">Sopladores</a>
            </nav>
            <p>El enlace activo recibe tratamiento de píldora hundida.</p>
          </div>
        </div>
      </section>

      <!-- Aplicado al sitio real -->
      <section class="neu-section">
        <h2>Aplicado a Continental</h2>
        <p class="neu-sub">
          Dos piezas reales del sitio traducidas al estilo, para juzgar el encaje y no sólo los
          componentes sueltos.
        </p>
        <p class="neu-sub">
          <strong>Regla de la fotografía:</strong> la imagen se apoya directamente sobre la
          superficie que la contiene. Sin marcos hundidos ni elevados alrededor: la tarjeta ya
          aporta un borde y la foto aporta el suyo, así que un marco intermedio agrega un tercero
          y ensucia la lectura.
        </p>

        <div class="neu-grid neu-grid-2">
          <article class="neu-raised neu-card neu-industry">
            <div class="neu-photo">
              <img src="/images/mineria/flotacion.webp" alt="Soplador centrífugo multietapa para flotación de minerales" width="800" height="600" loading="lazy" />
            </div>
            <h3>Sopladores para Minería</h3>
            <p>
              Aire y gas a presión para los procesos críticos de la gran minería. Caudal estable y
              alta eficiencia en faenas de altura.
            </p>
            <ul class="neu-list">
              <li>Sopladores para flotación de minerales</li>
              <li>Sopladores para transporte neumático por vacío</li>
              <li>Sopladores para combustión</li>
            </ul>
            <span class="neu-link">Ver más detalles →</span>
          </article>

          <div class="neu-raised neu-card neu-cta">
            <span class="neu-icon neu-icon-lg">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </span>
            <h3>¿Necesita una solución para su faena?</h3>
            <p>
              Nuestro equipo técnico dimensiona e integra el soplador ideal para cada proceso.
              Soporte, puesta en marcha y repuestos en toda la región andina.
            </p>
            <button class="neu-btn neu-btn-accent" type="button">Solicitar asesoría técnica</button>
          </div>
        </div>
      </section>

      <!-- Accesibilidad -->
      <section class="neu-section">
        <h2>Lo que hay que resolver</h2>
        <div class="neu-pressed neu-card neu-warn">
          <p>
            <strong>El borde de sombra da 1,72:1 contra el fondo.</strong> WCAG pide 3:1 para que
            un control se distinga de lo que lo rodea. Es la premisa del estilo —sombras en vez de
            bordes— así que no se arregla cambiando la paleta: hay que darle a botones e inputs
            algún refuerzo propio, sea un borde tenue, un fondo distinto o un contorno de foco
            permanente.
          </p>
          <p>
            <strong>El gris apagado #8898aa da 2,33:1.</strong> No sirve para texto. Si se necesita
            un secundario, hay que oscurecerlo hasta pasar 4,5:1.
          </p>
          <p>
            <strong>El estilo asume fondo claro.</strong> Esta página fuerza contexto claro y no
            usa variantes oscuras. Si el experimento avanza, hay que decidir qué pasa con el
            conmutador de tema que hoy tiene el sitio.
          </p>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
  /* Sólo lo exclusivo de esta página. El sistema vive en src/styles/neu.css */

  .neu-subhead { margin: 2.5rem 0 1rem; color: var(--neu-muted); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.75rem; }
  .neu-weights .neu-weight-sample { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .neu-weights .neu-weight-meta { font-size: 0.8125rem; color: var(--neu-accent); margin-top: 0; }
  .neu-weights .neu-weight-meta strong { font-weight: 600; }

  .neu-scale { padding: 0; }
  .neu-scale-row { display: grid; gap: 1.5rem; padding: 1.5rem 1.75rem; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); align-items: baseline; }
  .neu-scale-row + .neu-scale-row { box-shadow: inset 0 1px 0 rgba(163, 177, 198, 0.35); }
  .neu-scale-sample p { margin: 0; }
  .neu-scale-meta { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.8125rem; color: var(--neu-text); }
  .neu-scale-meta code { color: var(--neu-accent); }
  .neu-scale-use { color: var(--neu-text); opacity: 0.75; }

  @media (max-width: 47.99rem) {
    .neu-scale-row { grid-template-columns: 1fr; gap: 0.75rem; }
  }

  .neu-rules { margin-top: 2rem; }
  .neu-rules p { font-size: 0.9375rem; margin-bottom: 0.875rem; }
  .neu-rules p:last-child { margin-bottom: 0; }
  .neu-rules strong { font-weight: 600; color: var(--neu-accent); }

  .neu-swatch { height: 3.5rem; border-radius: 0.875rem; box-shadow: var(--neu-flat); margin-bottom: 1rem; }
  .neu-card p { font-size: 0.875rem; margin-top: 0.5rem; }
  .neu-code-block { display: block; white-space: pre-line; line-height: 1.6; margin-top: 0.5rem; }

  .neu-ratio { font-size: 0.75rem; font-weight: 500; margin-top: 0.75rem; }
  .neu-ratio.is-ok { color: var(--neu-accent); }
  .neu-ratio.is-fail { color: #b42318; }

  .neu-photo { margin-bottom: 1.5rem; }
  .neu-cta { display: flex; flex-direction: column; align-items: flex-start; }
  .neu-cta .neu-btn { margin-top: 1.5rem; }

  .neu-warn p { font-size: 0.9375rem; margin-bottom: 1rem; }
  .neu-warn p:last-child { margin-bottom: 0; }
  .neu-warn strong { font-weight: 600; }
</style>

<script>
  // Los interruptores son sólo demostrativos: alternan estado al hacer clic o
  // con teclado, para poder ver la transición de la perilla.
  document.querySelectorAll<HTMLElement>("[data-toggle]").forEach((el) => {
    const alternar = () => {
      const activo = el.classList.toggle("is-on");
      el.setAttribute("aria-checked", String(activo));
    };
    el.addEventListener("click", alternar);
    el.addEventListener("keydown", (e) => {
      if (e.key === " " || e.key === "Enter") {
        e.preventDefault();
        alternar();
      }
    });
  });
</script>
