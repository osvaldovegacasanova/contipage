---
import LazyImage from "../shared/LazyImage.astro";
import Title3 from "../shared/Title3.astro";
import Paragraph from "../shared/Paragraph.astro";
import type { IndustryProcess } from "../../data/industrias/types";

export interface Props {
  process: IndustryProcess;
  /** Zero-based index; drives the numbered badge and side alternation. */
  index: number;
}

const { process, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
// Even index: image left / text right. Odd index: image right / text left.
const imageRight = index % 2 === 1;
---

<article class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12 lg:gap-16">
  {/* Image */}
  <div class:list={["relative", imageRight && "md:order-2"]} data-scroll-blur>
    <div class="relative mx-auto w-4/5 overflow-hidden rounded-3xl shadow-lg dark:shadow-dark">
      <div class="aspect-[4/3] w-full">
        <LazyImage
          src={process.image}
          alt={process.alt}
          width="800"
          height="600"
          class="h-full w-full object-cover"
        />
      </div>
      {process.imagePlaceholder && (
        <span class="absolute right-3 top-3 rounded-full bg-black/55 px-2.5 py-1 text-[10px] font-medium uppercase tracking-wide text-white/90 backdrop-blur-sm">
          Imagen referencial
        </span>
      )}
    </div>
  </div>

  {/* Text */}
  <div class:list={["flex flex-col", imageRight && "md:order-1"]}>
    <div class="mb-4 flex items-center gap-4">
      <span class="text-3xl font-bold leading-none text-primary/25 dark:text-primary-400/40">
        {number}
      </span>
      <span class="h-px flex-1 bg-gradient-to-r from-primary/40 to-transparent"></span>
    </div>

    <Title3 as="h2" className="text-heading-1 dark:text-white">
      {process.name}
    </Title3>

    <Paragraph className="text-heading-3 leading-relaxed">
      {process.description}
    </Paragraph>

    {process.highlights && process.highlights.length > 0 && (
      <ul class="mt-6 space-y-3">
        {process.highlights.map((item) => (
          <li class="flex items-start gap-3 text-heading-3">
            <svg
              class="mt-1 h-4 w-4 shrink-0 text-secondary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            <span class="text-sm leading-relaxed md:text-[1rem]">{item}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
