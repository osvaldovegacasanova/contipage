---
import { enlacesNeu } from "./rutas";

// Barra de navegación del experimento. Existe porque la del sitio real, que
// aparece arriba en todas las páginas, apunta al sitio actual: sin esto no hay
// forma de recorrer la versión neumórfica ni de compartirla para que alguien la
// revise entera.
//
// Se marca la página en curso con el tratamiento de píldora hundida que ya
// define el sistema para el enlace activo.
export interface Props {
  /** Clave de la página en curso: "sistema", "home", "blog" o el hub corto. */
  activo?: string;
}

const { activo } = Astro.props;
---

<nav class="neu-barra" aria-label="Navegación del experimento">
  <span class="neu-barra-rotulo">Versión neumórfica</span>
  <div class="neu-nav neu-barra-enlaces">
    {enlacesNeu.map((e) => (
      <a href={e.href} class={e.clave === activo ? "is-active" : ""} aria-current={e.clave === activo ? "page" : undefined}>
        {e.texto}
      </a>
    ))}
  </div>
</nav>

<style is:global>
  .neu-barra {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem;
    padding-bottom: 2rem; margin-bottom: 2.5rem;
    box-shadow: inset 0 -1px 0 rgba(163, 177, 198, 0.4);
  }
  .neu-barra-rotulo {
    font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--neu-muted);
  }
  .neu-barra-enlaces { margin-bottom: 0; }
  .neu-barra-enlaces a { padding: 0.5rem 0.875rem; font-size: 0.8125rem; }
</style>
