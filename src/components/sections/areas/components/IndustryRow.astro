---
import LazyImage from "../../../shared/LazyImage.astro";
import GradiantText from "../../../shared/GradiantText.astro";
import type { IndustryArea } from "../data.ts";

export interface Props {
  area: IndustryArea;
  /** Zero-based index; drives left/right alternation. */
  index: number;
}

const { area, index } = Astro.props;

// Even index: image left / text right. Odd index: image right / text left.
const imageRight = index % 2 === 1;

const heading = area.seoHeading ?? `Sopladores para ${area.title}`;
const hasPage = Boolean(area.href);
const ctaHref = area.href ?? "/#contacto";
const ctaText = hasPage ? "Ver soluciones" : "Solicitar información";

const imageAlt =
  area.alt ||
  `Aplicaciones de sopladores centrífugos Continental Blowers en la industria ${area.title.toLowerCase()}`;
---

<article class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12 lg:gap-16">
  {/* Image */}
  <div class:list={["relative", imageRight && "md:order-2"]} data-scroll-blur>
    <div class="relative overflow-hidden rounded-3xl shadow-lg dark:shadow-dark">
      <div class="aspect-[4/3] w-full">
        <LazyImage
          src={area.visual}
          alt={imageAlt}
          width="800"
          height="600"
          class="h-full w-full object-cover"
          style={`object-position: ${area.objectPosition ?? "center"};`}
        />
      </div>
    </div>
  </div>

  {/* Text */}
  <div class:list={["flex flex-col", imageRight && "md:order-1"]}>
    <div class="mb-4 flex items-center gap-4">
      <span class="h-px w-10 bg-gradient-to-r from-primary to-transparent"></span>
      <span class="text-sm font-semibold uppercase tracking-[0.15em] text-primary/70">
        {area.title}
      </span>
    </div>

    <h2 class="title-fw text-2xl leading-tight text-heading-1 dark:text-white md:text-3xl">
      Sopladores para <GradiantText>{area.title}</GradiantText>
    </h2>

    {area.intro && (
      <p class="mt-4 leading-relaxed text-heading-3 md:text-lg">{area.intro}</p>
    )}

    <ul class="mt-6 space-y-3">
      {area.items.map((item) => (
        <li class="flex items-start gap-3 text-heading-3">
          <svg
            class="mt-1 h-4 w-4 shrink-0 text-secondary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
          <span class="text-sm leading-relaxed md:text-[1rem]">{item}</span>
        </li>
      ))}
    </ul>

    <div class="mt-8">
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors duration-200 hover:text-primary-800"
        aria-label={`${ctaText} — ${heading}`}
      >
        {ctaText}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
