---
import type { ImageMetadata } from "astro";
import Title3 from "../../../shared/Title3.astro";
import LazyImage from "../../../shared/LazyImage.astro";

export interface Props {
  title: string;
  bullets: string[];
  location: string;
  visual: string | ImageMetadata;
  alt?: string;
}

const { title, bullets, location, visual, alt } = Astro.props;
const imageAlt = alt || `${title} - Equipos de sopladores y compresores Continental Blowers`;
---

<div
  class="group overflow-hidden rounded-lg h-full flex flex-col dark:bg-base-dark-800 shadow-lg dark:shadow-dark ring-1 ring-black/5 pt-2"
>
  <div class="relative h-[307px] overflow-hidden">
    <LazyImage
      src={visual}
      alt={imageAlt}
      height="307"
      width="398"
      class="w-full h-[307px] object-contain"
    />
    <p
      class="absolute top-0 end-0 m-3 text-sm text-primary-900/50 dark:text-primary/70 font-semibold"
    >
      {location}
    </p>
  </div>
  <div class="grid grid-cols-1 content-start gap-3 w-full h-full p-6">
    <Title3 as="h2" className="dark:opacity-70">
      {title}
    </Title3>
    <ul class="space-y-2">
      {bullets.map((item) => (
        <li class="flex items-start gap-2.5 text-sm leading-relaxed text-heading-3">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
