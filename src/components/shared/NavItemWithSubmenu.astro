---
export interface SubmenuChild {
  href: string;
  text: string;
}

export interface Props {
  href: string;
  text: string;
  children: SubmenuChild[];
}

const { href, text, children } = Astro.props as Props;
---

<li class="group lg:relative">
  <div class="flex items-center justify-between gap-1">
    <a
      href={href}
      class="font-medium hover:text-primary-400 active:text-primary active:bg-primary-950/10 ease-linear duration-300 py-4 lg:py-3 block rounded-md px-2 -mx-2"
    >
      {text}
    </a>
    <!-- Caret: indicates the dropdown on desktop -->
    <span
      class="pointer-events-none flex items-center pr-2 lg:pr-0"
      aria-hidden="true"
    >
      <svg
        class="h-4 w-4 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </span>
  </div>

  <!--
    Mobile: static, indented sub-list (always visible within the open menu).
    Desktop (lg): absolutely-positioned dropdown revealed on hover / focus-within.
  -->
  <ul
    class="mt-1 flex flex-col gap-1 border-l border-box-border pl-4 lg:mt-0 lg:min-w-[280px] lg:border-0 lg:pl-0
           lg:absolute lg:left-0 lg:top-full lg:z-50 lg:rounded-2xl lg:bg-white lg:p-2 lg:shadow-xl lg:ring-1 lg:ring-black/5
           lg:invisible lg:translate-y-2 lg:opacity-0 lg:transition-all lg:duration-200
           lg:group-hover:visible lg:group-hover:translate-y-0 lg:group-hover:opacity-100
           lg:group-focus-within:visible lg:group-focus-within:translate-y-0 lg:group-focus-within:opacity-100"
  >
    {
      children.map((child) => (
        <li>
          <a
            href={child.href}
            class="block rounded-md px-2 py-3 text-[1rem] font-medium text-heading-2 transition-colors duration-200 hover:text-primary lg:px-3 lg:py-2.5 lg:hover:bg-primary-50"
          >
            {child.text}
          </a>
        </li>
      ))
    }
  </ul>
</li>
